{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/comicstudio.db"
  },
  "Storage": {
    "ArtifactsPath": "App_Data/artifacts"
  },
  "NovelAi": {
    "AccountBaseUrl": "https://image.novelai.net",
    "ImageBaseUrl": "https://image.novelai.net",
    "TextBaseUrl": "https://text.novelai.net"
  },
  "Curator": {
    "Concurrency": 2,
    "MaxConcurrentTextRequests": 2,
    "RetryBaseDelayMs": 600,
    "MaxOutputTokens": 4096,
    "EffectiveOutputTokens": 2048
  },
  "Generation": {
    "_comment": "AttachReferences is off because NovelAI 500s on our reference images: they are full page renders, and it requires 1024x1536, 1536x1024 or 1472x1472 padded with black. Turn on only after normalisation is confirmed against the live API.",
    "AttachReferences": false
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  }
}
